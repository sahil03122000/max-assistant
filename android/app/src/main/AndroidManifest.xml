<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Server se baat -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Aawaz sunna -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Papa ko call karo" — contact dhundhna aur call lagana -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Alarm/timer clock app mein lagana -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Reminder ki notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Hello Max": background mein hamesha sunne wali service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Background se Max ki screen kholne ke liye ("Display over other apps") -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Reminders ekdum sahi time par ("1 minute bache tab batana") -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Phone lock ho tab "Hello Max" par panel kholna (alarm/call jaisa full-screen) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Hello Max" sunte hi halki vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Battery saver Max ki service band na kare -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ mein doosre apps "dikhte" nahi jab tak yahan na batao -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.youtube" />
    </queries>

    <!-- usesCleartextTraffic: abhi laptop server http:// par hai. Cloud par HTTPS aane ke baad hata denge. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Max"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Max"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Hello Max" panel: alag task mein, recents mein nahi dikhta -->
        <activity
            android:name=".AssistantActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.max.assistant.panel"
            android:theme="@style/Theme.Max.Overlay" />

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
