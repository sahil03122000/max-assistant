# Is file ko copy karke ".env" naam se save karo aur values bharo.
# .env kabhi bhi GitHub par ya kisi ke saath share mat karna.

# https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=

# Koi bhi lamba random password (kam se kam 16 characters). Android app mein bhi yahi daalna hoga.
# Banane ke liye:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MAX_API_TOKEN=

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.5-flash
# PORT=3000
# TIMEZONE=Asia/Kolkata

# Groq (free, bahut tez AI) — https://console.groq.com → API Keys
# GROQ_API_KEY=
